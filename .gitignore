
# Dados pesados e caches locais (mantém a estrutura de pastas com .gitkeep se quiseres)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Ambientes virtuais e caches do Python
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class

# Notebooks e IDEs
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
